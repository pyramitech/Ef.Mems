        @:public ValueTask<(List<@(Model.Name)ReadOnly> Items, int MatchCount)> QuerySortCount@(srt.Name)(Predicate<@(Model.Name)ReadOnly> predicate, int skip, int take, bool descending = false)
        @:=> base.QuerySortCount<@(Model.Name)ReadOnly, @srt.Prop.Type, @(srt.SelectorStruct), KeyComparer<@srt.Prop.Type>>(@Model.QuerySource, predicate, new @(srt.SelectorStruct)(), default, skip, take, descending);
        @:public ValueTask<(List<@(Model.Name)ReadOnly> Items, int MatchCount)> QuerySortCount@(srt.Name)<TPred>(TPred predicate, int skip, int take, bool descending = false) where TPred : struct, IPredicate<@(Model.Name)ReadOnly>
        @:=> base.QuerySortCount<@(Model.Name)ReadOnly, @srt.Prop.Type, TPred, @(srt.SelectorStruct), KeyComparer<@srt.Prop.Type>>(@Model.QuerySource, predicate, new @(srt.SelectorStruct)(), default, skip, take, descending);
        @:public ValueTask<(List<@(Model.Name)ReadOnly> Items, int MatchCount)> QuerySortCount@(srt.Name)(int skip, int take, bool descending = false)
        @:=> base.QuerySortCount<@(Model.Name)ReadOnly, @srt.Prop.Type, MatchAll<@(Model.Name)ReadOnly>, @(srt.SelectorStruct), KeyComparer<@srt.Prop.Type>>(@Model.QuerySource, new MatchAll<@(Model.Name)ReadOnly>(), new @(srt.SelectorStruct)(), default, skip, take, descending);
        @:// no-count variants early-exit once the window is filled
        @:public ValueTask<List<@(Model.Name)ReadOnly>> QuerySort@(srt.Name)(Predicate<@(Model.Name)ReadOnly> predicate, int skip, int take, bool descending = false)
        @:=> base.SortedQuery(Volatile.Read(ref _sort_@(srt.Name)), predicate, skip, take, descending);
        @:public ValueTask<List<@(Model.Name)ReadOnly>> QuerySort@(srt.Name)<TPred>(TPred predicate, int skip, int take, bool descending = false) where TPred : struct, IPredicate<@(Model.Name)ReadOnly>
        @:=> base.SortedQuery(Volatile.Read(ref _sort_@(srt.Name)), predicate, skip, take, descending);
        @:public ValueTask<List<@(Model.Name)ReadOnly>> QuerySort@(srt.Name)(int skip, int take, bool descending = false)
        @:=> base.SortedQuery(Volatile.Read(ref _sort_@(srt.Name)), new MatchAll<@(Model.Name)ReadOnly>(), skip, take, descending);

        @:private void __SortInsert_@(srt.Name)(@(Model.Name)ReadOnly ro)
        @:{
        @:    var arr = _sort_@(srt.Name);
        @:    var key = ro.@(srt.Prop.Name);
        @:    int lo = 0, hi = arr.Length;
        @:    while (lo @("<") hi) { int mid = (lo + hi) >> 1; if (Comparer<@srt.Prop.Type>.Default.Compare(arr[mid].@(srt.Prop.Name), key) <= 0) lo = mid + 1; else hi = mid; }
        @:    var next = new @(Model.Name)ReadOnly[arr.Length + 1];
        @:    Array.Copy(arr, next, lo);
        @:    next[lo] = ro;
        @:    Array.Copy(arr, lo, next, lo + 1, arr.Length - lo);
        @:    Volatile.Write(ref _sort_@(srt.Name), next);
        @:}
