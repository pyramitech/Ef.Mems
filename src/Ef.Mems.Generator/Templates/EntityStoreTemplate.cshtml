@inherits RazorBlade.PlainTextTemplate<Ef.Mems.SourceGenerators.EntityModel>
@using Ef.Mems.SourceGenerators
@{
    // Sequential-index sources are ordered by the seq key, so their query
    // wrappers expose "descending" (walk the snapshot back to front).
    var descParam = Model.SeqIndex != null ? ", bool descending = false" : "";
    var descArg = Model.SeqIndex != null ? ", descending" : "";
}
    public sealed partial class @(Model.Name)EntityStore : EntityStore<@Model.EntityType>
    {
        private readonly @Model.Store.StoreType _store;
@foreach (var seq in Model.SeqIndexes)
{
        @:private @(Model.Name)ReadOnly[] _seq_@(seq.Name);
        @:private int _seqLen_@(seq.Name);
}
@foreach (var idx in Model.Indexes)
{
        @:private Dictionary<@idx.Type, @(Model.Name)ReadOnly> _idx_@(idx.Name);
}
@foreach (var srt in Model.MaterializedSorts)
{
        @:private @(Model.Name)ReadOnly[] _sort_@(srt.Name);
}
        public int Count { get; set; }

        public async Task Refresh()
        {
            using var ctx = _store.GetContext();
            var query = ctx.Set<@Model.EntityType>().AsQueryable().AsSplitQuery().AsNoTracking();
@if (Model.CachesAllProperties)
{
    foreach (var nav in Model.ManyNavs)
    {
            @:query = query.Include(e => e.@(nav.Nav));
    }
    foreach (var mtm in Model.ManyToManys)
    {
            @:query = query.Include(e => e.@(mtm.NavName));
    }
}
else
{
            @:// Partial cache: project only the cached columns (plus index
            @:// keys) and the declared navigations instead of loading full rows.
            @:query = query.Select(e => new @Model.EntityType
            @:{
    foreach (var p in Model.ProjectionProps)
    {
            @:    @(p.Name) = e.@(p.Name),
    }
    foreach (var nav in Model.ManyNavs)
    {
            @:    @(nav.Nav) = e.@(nav.Nav).ToList(),
    }
    foreach (var mtm in Model.ManyToManys)
    {
            @:    @(mtm.NavName) = e.@(mtm.NavName).ToList(),
    }
    foreach (var o in Model.Owneds)
    {
            @:    @(o.Name) = e.@(o.Name),
    }
            @:});
}
            using (await _rwl.WriterLockAsync()) {
                var all = await query.ToListAsync();
                this.Count = all.Count;
@foreach (var seq in Model.SeqIndexes)
{
                @:var max_@(seq.Name) = (all.Count == 0 ? 0 : all.Max(x => x.@(seq.Name))) + 1;
                @:var seq_@(seq.Name) = new @(Model.Name)ReadOnly[max_@(seq.Name)];
}
@foreach (var idx in Model.Indexes)
{
    if (idx.Type == "string")
    {
                @:var idx_@(idx.Name) = new Dictionary<@idx.Type, @(Model.Name)ReadOnly>(all.Count, StringComparer.Ordinal);
    }
    else
    {
                @:var idx_@(idx.Name) = new Dictionary<@idx.Type, @(Model.Name)ReadOnly>(all.Count);
    }
}
@if (Model.HasMaterializedSorts)
{
                @:var roBuffer = new List<@(Model.Name)ReadOnly>(all.Count);
}
                foreach (var e in all) {
                    var ro = new @(Model.Name)ReadOnly(e@(Model.RoCtorExtraArg));
@if (Model.HasMaterializedSorts)
{
                    @:roBuffer.Add(ro);
}
@foreach (var seq in Model.SeqIndexes)
{
                    @:seq_@(seq.Name)[e.@(seq.Name)] = ro;
}
@foreach (var idx in Model.Indexes)
{
                    @:idx_@(idx.Name)[@idx.KeyFrom("e")] = ro;
}
                }
@foreach (var srt in Model.MaterializedSorts)
{
                @:var sort_@(srt.Name) = roBuffer.ToArray();
                @:Array.Sort(sort_@(srt.Name), static (a, b) => Comparer<@srt.Prop.Type>.Default.Compare(a.@(srt.Prop.Name), b.@(srt.Prop.Name)));
                @:Volatile.Write(ref _sort_@(srt.Name), sort_@(srt.Name));
}
@foreach (var seq in Model.SeqIndexes)
{
                @:Volatile.Write(ref _seq_@(seq.Name), seq_@(seq.Name));
                @:_seqLen_@(seq.Name) = max_@(seq.Name);
}
@foreach (var idx in Model.Indexes)
{
                @:Volatile.Write(ref _idx_@(idx.Name), idx_@(idx.Name));
}
            }
        }

        internal @(Model.Name)EntityStore(@Model.Store.StoreType store)
        {
            _store = store;
            Refresh().ConfigureAwait(false).GetAwaiter().GetResult();
        }

@foreach (var seq in Model.SeqIndexes)
{
        @:public @(Model.Name)ReadOnly GetBy@(seq.Name)(@seq.Type key) { var seq = Volatile.Read(ref _seq_@(seq.Name)); return key >= 0 && key < seq.Length ? seq[key] : null; }
}
@foreach (var idx in Model.Indexes)
{
        @:public @(Model.Name)ReadOnly GetBy@(idx.Name)(@idx.GetByParams) => Volatile.Read(ref _idx_@(idx.Name)).TryGetValue(@idx.GetByKey, out var v) ? v : null;
}
@if (Model.SeqIndex != null && Model.SeqIndexGuard)
{

        @:// Compares against the sequence high-water mark (not Count): with
        @:// create/delete churn ids grow while Count stays flat, and that is
        @:// legitimate - only ids far beyond the sequence are anomalous.
        @:private void __GuardSequentialIndex(long id)
        @:{
        @:    if (id > 1024L + (long)_seqLen_@(Model.SeqIndex.Name) * 4L)
        @:        throw new SparseSequentialIndexException("@Model.Name sequential index value " + id + " is far beyond the sequence high-water mark " + _seqLen_@(Model.SeqIndex.Name) + " - UseSequentialIndex assumes dense sequential keys (disable via UseSafety(sequentialIndexGuard: false))");
        @:}
}
@if (Model.NeedsClone)
{

        @:// Safety clone (UseSafety copyOnInsert/copyOnStage): entities enter
        @:// the cache as private copies, so callers may keep mutating theirs.
        @:private static @Model.EntityType __Clone(@Model.EntityType source)
        @:{
        @:    return new @Model.EntityType
        @:    {
    foreach (var p in Model.CloneProps)
    {
        @:        @p.Name = @(p.CloneExpr("source")),
    }
    foreach (var nav in Model.ManyNavs)
    {
        @:        @(nav.Nav) = source.@(nav.Nav)?.Select(c => new @nav.ChildType { @nav.CloneInit }).ToList(),
    }
    foreach (var mtm in Model.ManyToManys)
    {
        @:        @(mtm.NavName) = source.@(mtm.NavName)?.Select(c => new @mtm.ChildType { @mtm.CloneInit }).ToList(),
    }
    foreach (var o in Model.Owneds)
    {
        @:        @(o.Name) = @(o.CloneExpr("source")),
    }
        @:    };
        @:}
}

        // One commit per transaction and store: creates, updates and deletes
        // are applied under a single writer-lock hold (parked at the gate
        // until the transaction saves and publishes), so mixing operation
        // kinds on this store cannot deadlock on its own lock.
        public override async Task CommitTransaction(Promise gate, DbContext ctx, ICollection<object> creates, ICollection<object> updates, ICollection<object> deletes, TaskCompletionSource ready, EntityTransaction.TransactionUpdateInterals internals, object context)
        {
            var gateConsumed = false;
            try
            {
                __GuardDuplicateStaging(creates, updates, deletes);
                using (await _rwl.WriterLockAsync())
                {
@if (Model.CanCreate)
{
                    @:if (creates.Count != 0) __CommitCreates(ctx, creates, internals, context);
}
else
{
                    @:if (creates.Count != 0) throw new NotSupportedException("@Model.Name store was built without create support (UseFeatures)");
}
@if (Model.CanUpdate)
{
                    @:if (updates.Count != 0) __CommitUpdateDiffs(ctx, updates, internals, context);
}
else
{
                    @:if (updates.Count != 0) throw new NotSupportedException("@Model.Name store was built without update support (UseFeatures)");
}
@if (Model.CanDelete)
{
                    @:if (deletes.Count != 0) __CommitDeletes(ctx, deletes, internals, context);
}
else
{
                    @:if (deletes.Count != 0) throw new NotSupportedException("@Model.Name store was built without delete support (UseFeatures)");
}
                    ready.TrySetResult();
                    gateConsumed = true;
                    await gate;
                }
            }
            catch (Exception ex)
            {
                // Signal the transaction and consume the gate exactly once,
                // so a faulting commit can neither hang Commit() nor leak an
                // unobserved promise.
                ready.TrySetException(ex);
                if (!gateConsumed) { try { await gate; } catch { } }
                throw;
            }
        }

        // An entity may be staged at most once per transaction, in exactly
        // one operation. Creates without an assigned key are exempt (their
        // key is generated during the commit).
        private void __GuardDuplicateStaging(ICollection<object> creates, ICollection<object> updates, ICollection<object> deletes)
        {
            var keys = new HashSet<@(Model.UpdateKeyType)>();
            void Check(ICollection<object> staged, bool allowDefaultKey)
            {
                foreach (var obj in staged)
                {
                    var key = (obj as @(Model.EntityType)).@(Model.UpdateKey);
                    if (allowDefaultKey && EqualityComparer<@(Model.UpdateKeyType)>.Default.Equals(key, default)) continue;
                    if (!keys.Add(key)) throw new DuplicateStagedEntityException("@Model.Name with @Model.UpdateKey " + key + " is staged more than once in this transaction - an entity may appear at most once per transaction");
                }
            }
            Check(creates, allowDefaultKey: true);
            Check(updates, allowDefaultKey: false);
            Check(deletes, allowDefaultKey: false);
        }

