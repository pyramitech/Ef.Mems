        public async Task<bool> Delete(@Model.EntityType item@(Model.ContextParam))
        {
@foreach (var ext in Model.Extensions)
{
    if (ext.HasBeforeDelete)
    {
            @:@(ext.Type).BeforeDelete(_store, item@(ext.ValuesArg)@(ext.ContextArg));
    }
}
            using var ctx = _store.GetContext();
            ctx.Remove(item);
            using (await _rwl.WriterLockAsync()) {
                var removed = await ctx.SaveChangesAsync() > 0;
                if (!removed) return false;
@if (Model.HasMaterializedSorts)
{
                @:var oldRoSort = GetBy@(Model.UpdateKey)(item.@(Model.UpdateKey));
}
@if (Model.SeqIndex != null)
{
                @:_seq_@(Model.SeqIndex.Name)[item.@(Model.SeqIndex.Name)] = null;
}
@foreach (var idx in Model.Indexes)
{
                @:Snapshot.RemoveItem(ref _idx_@(idx.Name), @idx.KeyFrom("item"));
}
@foreach (var srt in Model.MaterializedSorts)
{
                @:if (oldRoSort != null) __SortRemove_@(srt.Name)(oldRoSort);
}
                --this.Count;
                #pragma warning disable CS0618
@foreach (var mtm in Model.ManyToManys)
{
    foreach (var target in mtm.Others)
    {
                @:for (int i = 0; i < (item.@(mtm.NavName)?.Count ?? 0); i++) {
                    @:var mtm = item.@(mtm.NavName)[i];
    Write(new MtmRemoveCoreTemplate(mtm.Fragment(target)));
                @:}
    }
}
                #pragma warning restore CS0618
                return true;
            }
        }

