                this.Count -= items.Count;
@foreach (var idx in Model.Indexes)
{
                @:var idx_@(idx.Name) = Snapshot.Clone(_idx_@(idx.Name));
}
                foreach (var item in items) {
@if (Model.HasMaterializedSorts)
