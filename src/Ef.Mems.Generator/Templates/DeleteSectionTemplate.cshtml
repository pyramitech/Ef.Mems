        // Bulk delete-all + identity reseed, mirroring what Refresh() would
        // publish for an empty table. TRUNCATE semantics: rows are not
        // enumerated and Before* hooks do NOT run. Other stores' cached
        // many-to-many navigations referencing these rows stay stale until
        // their Refresh(). Returns the number of rows deleted.
        public async Task<int> Truncate()
        {
            using var ctx = _store.GetContext();
            using (await _rwl.WriterLockAsync()) {
                var deleted = await Truncation.DeleteAllAndReseed<@Model.EntityType>(ctx);
                this.Count = 0;
@foreach (var seq in Model.SeqIndexes)
{
                @:Volatile.Write(ref _seq_@(seq.Name), new @(Model.Name)ReadOnly[1]);
                @:_seqLen_@(seq.Name) = 1;
}
@foreach (var idx in Model.Indexes)
{
    if (idx.Type == "string")
    {
                @:Volatile.Write(ref _idx_@(idx.Name), new Dictionary<@idx.Type, @(Model.Name)ReadOnly>(StringComparer.Ordinal));
    }
    else
    {
                @:Volatile.Write(ref _idx_@(idx.Name), new Dictionary<@idx.Type, @(Model.Name)ReadOnly>());
    }
}
@foreach (var srt in Model.MaterializedSorts)
{
                @:Volatile.Write(ref _sort_@(srt.Name), Array.Empty<@(Model.Name)ReadOnly>());
}
                return deleted;
            }
        }

        public void StageDelete(EntityTransaction trx, ICollection<@Model.EntityType> items)
        {
            trx.StageDelete(this, items);
        }

        public void StageDelete(EntityTransaction trx, @Model.EntityType item)
        {
            trx.StageDelete(this, item);
        }

