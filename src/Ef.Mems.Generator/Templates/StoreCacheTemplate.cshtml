@inherits RazorBlade.PlainTextTemplate<Ef.Mems.SourceGenerators.StoreModel>
@using Ef.Mems.SourceGenerators
// <auto-generated />
using System;
using System.ComponentModel;
using System.Collections.Generic;
using System.Linq;
using System.Runtime.CompilerServices;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.ChangeTracking;
using Proto.Promises.Threading;
using Proto.Promises;
using Ef.Mems;
using Ef.Mems.Extensions;

@if (!string.IsNullOrEmpty(Model.Namespace))
{
@:namespace @Model.Namespace
@:{
}
    file interface IEntityAccessor<out T> {
        T __GetRawEntity();
    }
    file static class EntityAccessorExtensions {
        public static T __GetRawEntity<T>(this IEntityAccessor<T> src) => src.__GetRawEntity();
    }
    file static class EntityCommitFunctions {
@foreach (var join in Model.CommitJoins)
{
    Write(new CommitFunctionsTemplate(join));
}
    }
@foreach (var dto in Model.ChildDtos)
{
    Write(new ChildReadOnlyTemplate(dto));
}
@foreach (var owned in Model.OwnedDtos)
{
    Write(new OwnedReadOnlyTemplate(owned));
}
@foreach (var entity in Model.Entities)
{
    Write(new ReadOnlyDtoTemplate(entity));

    Write(new EntityStoreTemplate(entity));
}
@foreach (var union in Model.Unions)
{
    Write(new UnionTemplate(union));
}
    public static class @(Model.StoreName)BuilderExtensions
    {
@foreach (var entity in Model.Entities)
{
        @:public static @(entity.Name)EntityStore Build(this EntityStoreBuilder<@Model.ContextType,@entity.EntityType> b) => new @(entity.Name)EntityStore(b.Store as @Model.StoreType);
}
@foreach (var union in Model.Unions)
{
        @:public static @union.ClassName Build(this UnionBuilder<@Model.ContextType, @union.MemberTypeArgs> b) => new @(union.ClassName)(@union.BuildArgs);
}
    }
@if (!string.IsNullOrEmpty(Model.Namespace))
{
@:}
}
